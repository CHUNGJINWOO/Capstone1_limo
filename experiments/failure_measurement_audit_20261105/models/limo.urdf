<?xml version="1.0" ?>
<robot name="limo" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Base footprint and links -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 1.57" />
      <geometry>
        <mesh filename="file:///home/cjinw/simulator-research/limo_sim_ws/install/limo_description/share/limo_description/meshes/limo_base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.13 0.12 0.1"/>
      </geometry>
    </collision>
  </link>

  <link name="inertial_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" />
      <mass value="2.1557" />
      <inertia ixx="0.24" ixy="0" ixz="0" 
               iyy="0.96" iyz="0" 
               izz="0.96" />
    </inertial>
  </link>

  <joint name="inertial_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="inertial_link" />
  </joint>

  <!-- Laser Sensor Link -->
  <link name="laser_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0.0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.01"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="0.103 0 -0.034" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser_link"/>
  </joint>

  <!-- IMU Link -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0.0 0 -0.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- Left Steering Hinge -->
  <link name="left_steering_hinge">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
      <origin xyz="0 0 0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.01" radius="0.01" />
      </geometry>
    </visual>
  </link>

  <joint name="left_steering_hinge_wheel" type="revolute">
    <parent link="base_link"/>
    <child link="left_steering_hinge"/>
    <origin xyz="0.1 0.07 -0.100998" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.52359877" upper="0.52359877" effort="1000.0" velocity="1.0" />
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Front Left Wheel -->
  <link name="front_left_wheel_link">
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.01055" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.01055" />
      <origin xyz="0 0 0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/cjinw/simulator-research/limo_sim_ws/install/limo_description/share/limo_description/meshes/limo_wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.0225 0" rpy="1.57 0 0" />
      <geometry>
        <cylinder length="0.045" radius="0.045" />
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel" type="continuous">
    <parent link="left_steering_hinge"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Right Steering Hinge -->
  <link name="right_steering_hinge">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
      <origin xyz="0 0 0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.01" radius="0.01" />
      </geometry>
    </visual>
  </link>

  <joint name="right_steering_hinge_wheel" type="revolute">
    <parent link="base_link"/>
    <child link="right_steering_hinge"/>
    <origin xyz="0.1 -0.07 -0.100998" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.52359877" upper="0.52359877" effort="1000.0" velocity="1.0" />
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Front Right Wheel -->
  <link name="front_right_wheel_link">
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.01055" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.01055" />
      <origin xyz="0 0 0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="3.14159 0 0" />
      <geometry>
        <mesh filename="file:///home/cjinw/simulator-research/limo_sim_ws/install/limo_description/share/limo_description/meshes/limo_wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.0225 0" rpy="1.57 0 0" />
      <geometry>
        <cylinder length="0.045" radius="0.045" />
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel" type="continuous">
    <parent link="right_steering_hinge"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Rear Left Wheel -->
  <link name="rear_left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.01055" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.01055" /> 
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/cjinw/simulator-research/limo_sim_ws/install/limo_description/share/limo_description/meshes/limo_wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.0225 0" rpy="1.57 0 0" />
      <geometry>
        <cylinder length="0.045" radius="0.045" />
      </geometry>
    </collision>
  </link>

  <joint name="rear_left_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.1 0.07 -0.100998" rpy="0 0 0" />
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Rear Right Wheel -->
  <link name="rear_right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.01055" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.01055" /> 
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="3.14159 0 0" />
      <geometry>
        <mesh filename="file:///home/cjinw/simulator-research/limo_sim_ws/install/limo_description/share/limo_description/meshes/limo_wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.0225 0" rpy="1.57 0 0" />
      <geometry>
        <cylinder length="0.045" radius="0.045" />
      </geometry>
    </collision>
  </link>

  <joint name="rear_right_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="-0.1 -0.07 -0.100998" rpy="0 0 0" />
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- Gazebo Sensors and Systems -->
  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <ignition_frame_id>laser_link</ignition_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <topic>/imu</topic>
      <update_rate>100</update_rate>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="libignition-gazebo-ackermann-steering-system.so" name="ignition::gazebo::systems::AckermannSteering">
      <left_joint>rear_left_wheel</left_joint>
      <right_joint>rear_right_wheel</right_joint>
      <left_steering_joint>left_steering_hinge_wheel</left_steering_joint>
      <right_steering_joint>right_steering_hinge_wheel</right_steering_joint>
      <wheel_separation>0.14</wheel_separation>
      <wheel_base>0.20</wheel_base>
      <wheel_radius>0.045</wheel_radius>
      <steering_limit>0.52359877</steering_limit>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
