<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="low_obstacle_hurdle">
    <static>true</static>
    <link name="hurdle_link">
      <!-- Low obstacle: 8cm height, spanning across corridor (X=0.70m, Y=0.10m thickness). Center at z=0.04m -->
      <visual name="vis">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry><box><size>0.70 0.10 0.08</size></box></geometry>
        <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="col">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry><box><size>0.70 0.10 0.08</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
