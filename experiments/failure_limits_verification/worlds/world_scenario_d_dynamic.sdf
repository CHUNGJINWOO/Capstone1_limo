<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mc3f_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.92 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.25 0.15 -0.95</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_plane_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.74 0.76 0.80 1</ambient><diffuse>0.74 0.76 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Dual-path Corridor Environment for Dynamic Obstacle Injection -->
    <!-- Robot starts at (-2.5, 0.0) facing East (+x) -->
    <!-- Main corridor runs from x = -2.5 to x = +2.5 at y = 0.0 -->
    <!-- Bypass corridor loops through y = 1.4 from x = -1.0 to x = 1.0 -->
    <model name="dynamic_corridor_env">
      <static>true</static>
      <link name="walls">
        <!-- South Wall: y = -0.7 -->
        <collision name="w_s"><pose>0.0 -0.7 0.45 0 0 0</pose><geometry><box><size>6.0 0.2 0.9</size></box></geometry></collision>
        <visual name="vw_s"><pose>0.0 -0.7 0.45 0 0 0</pose><geometry><box><size>6.0 0.2 0.9</size></box></geometry><material><ambient>0.3 0.3 0.4 1</ambient><diffuse>0.3 0.3 0.4 1</diffuse></material></visual>

        <!-- West End Wall: x = -2.9 -->
        <collision name="w_w"><pose>-2.9 0.0 0.45 0 0 0</pose><geometry><box><size>0.2 1.6 0.9</size></box></geometry></collision>
        <visual name="vw_w"><pose>-2.9 0.0 0.45 0 0 0</pose><geometry><box><size>0.2 1.6 0.9</size></box></geometry><material><ambient>0.3 0.3 0.4 1</ambient><diffuse>0.3 0.3 0.4 1</diffuse></material></visual>

        <!-- East End Wall: x = +2.9 -->
        <collision name="w_e"><pose>2.9 0.0 0.45 0 0 0</pose><geometry><box><size>0.2 1.6 0.9</size></box></geometry></collision>
        <visual name="vw_e"><pose>2.9 0.0 0.45 0 0 0</pose><geometry><box><size>0.2 1.6 0.9</size></box></geometry><material><ambient>0.3 0.3 0.4 1</ambient><diffuse>0.3 0.3 0.4 1</diffuse></material></visual>

        <!-- Central Island separating Main Corridor (y=0) and Bypass (y=1.4) -->
        <!-- Island from x = -0.8 to x = +0.8, y in [0.5, 0.9] -->
        <collision name="island"><pose>0.0 0.7 0.45 0 0 0</pose><geometry><box><size>1.6 0.4 0.9</size></box></geometry></collision>
        <visual name="visland"><pose>0.0 0.7 0.45 0 0 0</pose><geometry><box><size>1.6 0.4 0.9</size></box></geometry><material><ambient>0.5 0.5 0.6 1</ambient><diffuse>0.5 0.5 0.6 1</diffuse></material></visual>

        <!-- North Outer Wall of Bypass: y = 2.0 -->
        <collision name="w_n_bypass"><pose>0.0 2.0 0.45 0 0 0</pose><geometry><box><size>3.6 0.2 0.9</size></box></geometry></collision>
        <visual name="vw_n_bypass"><pose>0.0 2.0 0.45 0 0 0</pose><geometry><box><size>3.6 0.2 0.9</size></box></geometry><material><ambient>0.3 0.3 0.4 1</ambient><diffuse>0.3 0.3 0.4 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
