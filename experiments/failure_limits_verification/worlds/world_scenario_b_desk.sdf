<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mc3f_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.92 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.25 0.15 -0.95</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_plane_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.74 0.76 0.80 1</ambient>
            <diffuse>0.74 0.76 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room Walls: 6m x 6m room -->
    <model name="desk_room_walls">
      <static>true</static>
      <link name="walls">
        <!-- South Wall -->
        <collision name="w_s"><pose>0 -3.1 0.5 0 0 0</pose><geometry><box><size>6.2 0.2 1.0</size></box></geometry></collision>
        <visual name="vw_s"><pose>0 -3.1 0.5 0 0 0</pose><geometry><box><size>6.2 0.2 1.0</size></box></geometry><material><ambient>0.3 0.3 0.4 1</ambient><diffuse>0.3 0.3 0.4 1</diffuse></material></visual>

        <!-- North Wall -->
        <collision name="w_n"><pose>0 3.1 0.5 0 0 0</pose><geometry><box><size>6.2 0.2 1.0</size></box></geometry></collision>
        <visual name="vw_n"><pose>0 3.1 0.5 0 0 0</pose><geometry><box><size>6.2 0.2 1.0</size></box></geometry><material><ambient>0.3 0.3 0.4 1</ambient><diffuse>0.3 0.3 0.4 1</diffuse></material></visual>

        <!-- West Wall -->
        <collision name="w_w"><pose>-3.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 6.2 1.0</size></box></geometry></collision>
        <visual name="vw_w"><pose>-3.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 6.2 1.0</size></box></geometry><material><ambient>0.3 0.3 0.4 1</ambient><diffuse>0.3 0.3 0.4 1</diffuse></material></visual>

        <!-- East Wall -->
        <collision name="w_e"><pose>3.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 6.2 1.0</size></box></geometry></collision>
        <visual name="vw_e"><pose>3.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 6.2 1.0</size></box></geometry><material><ambient>0.3 0.3 0.4 1</ambient><diffuse>0.3 0.3 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Student Desk with Low Crossbars and Chair (Placed directly in path of robot exploration) -->
    <!-- Desk centered at x = 0.0, y = 0.5 -->
    <!-- Legs: x = +/- 0.40, y = 0.5 +/- 0.25 (Spacing 0.80m x 0.50m) -->
    <model name="student_desk_with_crossbar">
      <static>true</static>
      <!-- Table Top -->
      <link name="table_top">
        <collision name="top_c"><pose>0.0 0.5 0.72 0 0 0</pose><geometry><box><size>1.0 0.6 0.04</size></box></geometry></collision>
        <visual name="top_v"><pose>0.0 0.5 0.72 0 0 0</pose><geometry><box><size>1.0 0.6 0.04</size></box></geometry><material><ambient>0.82 0.62 0.42 1</ambient><diffuse>0.82 0.62 0.42 1</diffuse></material></visual>
      </link>

      <!-- 4 Vertical Legs (Detected by LiDAR at z = 0.116m) -->
      <link name="desk_legs">
        <!-- Leg Front-Left: x=-0.40, y=0.25 -->
        <collision name="leg_fl"><pose>-0.40 0.25 0.35 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="v_leg_fl"><pose>-0.40 0.25 0.35 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.70</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>

        <!-- Leg Front-Right: x=0.40, y=0.25 -->
        <collision name="leg_fr"><pose>0.40 0.25 0.35 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="v_leg_fr"><pose>0.40 0.25 0.35 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.70</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>

        <!-- Leg Rear-Left: x=-0.40, y=0.75 -->
        <collision name="leg_rl"><pose>-0.40 0.75 0.35 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="v_leg_rl"><pose>-0.40 0.75 0.35 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.70</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>

        <!-- Leg Rear-Right: x=0.40, y=0.75 -->
        <collision name="leg_rr"><pose>0.40 0.75 0.35 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="v_leg_rr"><pose>0.40 0.75 0.35 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.70</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>

      <!-- Horizontal Reinforcement Crossbar at z = 0.05m (UNDER-SCAN PLANE: z_crossbar=0.05m < z_lidar=0.116m) -->
      <!-- Connects front legs x=-0.40 and x=+0.40 at y=0.25 -->
      <link name="under_scan_crossbar">
        <collision name="c_crossbar_front">
          <pose>0.0 0.25 0.05 0 0 0</pose>
          <geometry><box><size>0.80 0.03 0.03</size></box></geometry>
        </collision>
        <!-- Notice: No visual geometry at LiDAR height z=0.116m, so LiDAR sees completely open space between legs! -->
      </link>

      <!-- Chair with tight clearance next to desk -->
      <link name="chair_link">
        <!-- Chair Seat at x = 0.0, y = 1.05, z = 0.45 -->
        <collision name="chair_seat_c"><pose>0.0 1.05 0.45 0 0 0</pose><geometry><box><size>0.4 0.4 0.04</size></box></geometry></collision>
        <visual name="chair_seat_v"><pose>0.0 1.05 0.45 0 0 0</pose><geometry><box><size>0.4 0.4 0.04</size></box></geometry><material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material></visual>
        
        <!-- Chair Legs -->
        <collision name="chair_l1"><pose>-0.16 0.89 0.22 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="v_chair_l1"><pose>-0.16 0.89 0.22 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>

        <collision name="chair_l2"><pose>0.16 0.89 0.22 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="v_chair_l2"><pose>0.16 0.89 0.22 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>

        <collision name="chair_l3"><pose>-0.16 1.21 0.22 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="v_chair_l3"><pose>-0.16 1.21 0.22 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>

        <collision name="chair_l4"><pose>0.16 1.21 0.22 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.44</length></cylinder></geometry></collision>
        <visual name="v_chair_l4"><pose>0.16 1.21 0.22 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.44</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
