<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mc3f_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Ignition Gazebo Systems -->
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_plane_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.72 0.74 0.77 1</ambient>
            <diffuse>0.72 0.74 0.77 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- C103 Classroom & Corridor Structure: Condition 2 (Glass invisible to LiDAR) -->
    <model name="c103_environment">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      
      <!-- Outer Boundary Walls -->
      <link name="outer_walls">
        <collision name="wall_south">
          <pose>0.0 -2.3 0.5 0 0 0</pose>
          <geometry><box><size>8.4 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="v_wall_south">
          <pose>0.0 -2.3 0.5 0 0 0</pose>
          <geometry><box><size>8.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.3 0.35 0.45 1</ambient><diffuse>0.3 0.35 0.45 1</diffuse></material>
        </visual>

        <collision name="wall_north">
          <pose>0.0 4.1 0.5 0 0 0</pose>
          <geometry><box><size>8.4 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="v_wall_north">
          <pose>0.0 4.1 0.5 0 0 0</pose>
          <geometry><box><size>8.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.3 0.35 0.45 1</ambient><diffuse>0.3 0.35 0.45 1</diffuse></material>
        </visual>

        <collision name="wall_west">
          <pose>-4.1 0.9 0.5 0 0 0</pose>
          <geometry><box><size>0.2 6.6 1.0</size></box></geometry>
        </collision>
        <visual name="v_wall_west">
          <pose>-4.1 0.9 0.5 0 0 0</pose>
          <geometry><box><size>0.2 6.6 1.0</size></box></geometry>
          <material><ambient>0.3 0.35 0.45 1</ambient><diffuse>0.3 0.35 0.45 1</diffuse></material>
        </visual>

        <collision name="wall_east">
          <pose>4.1 0.9 0.5 0 0 0</pose>
          <geometry><box><size>0.2 6.6 1.0</size></box></geometry>
        </collision>
        <visual name="v_wall_east">
          <pose>4.1 0.9 0.5 0 0 0</pose>
          <geometry><box><size>0.2 6.6 1.0</size></box></geometry>
          <material><ambient>0.3 0.35 0.45 1</ambient><diffuse>0.3 0.35 0.45 1</diffuse></material>
        </visual>
      </link>

      <!-- Dividing Wall at y = 0.0 -->
      <link name="dividing_wall_solid">
        <collision name="wall_div_west">
          <pose>-3.0 0.0 0.5 0 0 0</pose>
          <geometry><box><size>2.0 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="v_wall_div_west">
          <pose>-3.0 0.0 0.5 0 0 0</pose>
          <geometry><box><size>2.0 0.2 1.0</size></box></geometry>
          <material><ambient>0.3 0.35 0.45 1</ambient><diffuse>0.3 0.35 0.45 1</diffuse></material>
        </visual>

        <!-- Door Opening: x in [-2.0, -1.0] (Width 1.0m, completely free for robot passage) -->

        <!-- Door Pillar / Frame: x in [-1.0, -0.9] -->
        <collision name="door_pillar">
          <pose>-0.95 0.0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="v_door_pillar">
          <pose>-0.95 0.0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 0.2 1.0</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <!-- Lower Kickplate under the Glass Wall: x in [-0.9, 4.0], length 4.9m, height 10cm (z in [0, 0.10]) -->
        <!-- Robot LiDAR is at z=0.161m, which shoots ABOVE this 10cm kickplate! -->
        <collision name="kickplate_collision">
          <pose>1.55 0.0 0.05 0 0 0</pose>
          <geometry><box><size>4.9 0.15 0.10</size></box></geometry>
        </collision>
        <visual name="v_kickplate">
          <pose>1.55 0.0 0.05 0 0 0</pose>
          <geometry><box><size>4.9 0.15 0.10</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>

      <!-- Glass Partition Section: Physical Collision ALWAYS blocks the robot, but NO Visual geometry -->
      <!-- In Gazebo Fortress gpu_lidar, rays pass through and hit obstacles inside classroom! -->
      <link name="glass_wall_link">
        <collision name="glass_physical_collision">
          <pose>1.55 0.0 0.80 0 0 0</pose>
          <geometry><box><size>4.9 0.08 1.40</size></box></geometry>
        </collision>
        <!-- Notice: visual is intentionally omitted so gpu_lidar renders transparent space -->
      </link>

      <!-- Classroom Interior Obstacles (Desks, Chairs, Podium, Whiteboard) -->
      <link name="classroom_furniture">
        <collision name="desk_1">
          <pose>0.5 1.8 0.38 0 0 0</pose>
          <geometry><box><size>1.6 0.6 0.75</size></box></geometry>
        </collision>
        <visual name="v_desk_1">
          <pose>0.5 1.8 0.38 0 0 0</pose>
          <geometry><box><size>1.6 0.6 0.75</size></box></geometry>
          <material><ambient>0.8 0.6 0.4 1</ambient><diffuse>0.8 0.6 0.4 1</diffuse></material>
        </visual>

        <collision name="desk_2">
          <pose>2.6 1.8 0.38 0 0 0</pose>
          <geometry><box><size>1.6 0.6 0.75</size></box></geometry>
        </collision>
        <visual name="v_desk_2">
          <pose>2.6 1.8 0.38 0 0 0</pose>
          <geometry><box><size>1.6 0.6 0.75</size></box></geometry>
          <material><ambient>0.8 0.6 0.4 1</ambient><diffuse>0.8 0.6 0.4 1</diffuse></material>
        </visual>

        <collision name="podium">
          <pose>-1.8 2.2 0.5 0 0 0</pose>
          <geometry><box><size>0.8 0.6 1.0</size></box></geometry>
        </collision>
        <visual name="v_podium">
          <pose>-1.8 2.2 0.5 0 0 0</pose>
          <geometry><box><size>0.8 0.6 1.0</size></box></geometry>
          <material><ambient>0.4 0.25 0.15 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>

        <collision name="cabinet">
          <pose>1.5 3.7 0.6 0 0 0</pose>
          <geometry><box><size>2.4 0.5 1.2</size></box></geometry>
        </collision>
        <visual name="v_cabinet">
          <pose>1.5 3.7 0.6 0 0 0</pose>
          <geometry><box><size>2.4 0.5 1.2</size></box></geometry>
          <material><ambient>0.2 0.3 0.25 1</ambient><diffuse>0.2 0.3 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
