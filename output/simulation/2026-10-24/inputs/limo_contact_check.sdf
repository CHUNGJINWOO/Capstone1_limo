<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <model name="limo">
    <pose>0 0 0.05 0 0 0</pose>


    <link name="base_footprint">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.1557</mass>
        <inertia>
          <ixx>0.24</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.96</iyy><iyz>0</iyz><izz>0.96</izz>
        </inertia>
      </inertial>

      <visual name="base_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.13 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.25 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
        </material>
      </visual>
      <collision name="base_collision">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.13 0.10</size>
          </box>
        </geometry>
      </collision>


      <visual name="laser_visual">
        <pose>0.103 0 0.116 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.9 0.2 0.2 1</diffuse>
        </material>
      </visual>


      <sensor name="lidar" type="gpu_lidar">
        <pose>0.103 0 0.116 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <ignition_frame_id>laser_link</ignition_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>


      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <topic>/imu</topic>
        <update_rate>100</update_rate>
        <ignition_frame_id>imu_link</ignition_frame_id>
        <always_on>1</always_on>
      </sensor>
    </link>


    <link name="left_steering_hinge">
      <pose>0.10 0.07 0.0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="left_hinge_visual">
        <geometry>
          <cylinder><radius>0.01</radius><length>0.02</length></cylinder>
        </geometry>
      </visual>
    </link>

    <joint name="left_steering_hinge_wheel" type="revolute">
      <parent>base_footprint</parent>
      <child>left_steering_hinge</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.52359877</lower>
          <upper>0.52359877</upper>
          <effort>1000.0</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics><damping>0.5</damping><friction>0.1</friction></dynamics>
      </axis>
    </joint>


    <link name="front_left_wheel_link">
      <pose>0.10 0.07 0.0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01055</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00075</iyy><iyz>0</iyz><izz>0.01055</izz>
        </inertia>
      </inertial>
      <visual name="fl_wheel_visual">
        <geometry>
          <mesh>
            <uri>file:///home/cjinw/simulator-research/limo_sim_ws/install/limo_description/share/limo_description/meshes/limo_wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="fl_wheel_collision">
        <pose>0 0.0225 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <joint name="front_left_wheel" type="revolute">
      <parent>left_steering_hinge</parent>
      <child>front_left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>


    <link name="right_steering_hinge">
      <pose>0.10 -0.07 0.0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="right_hinge_visual">
        <geometry>
          <cylinder><radius>0.01</radius><length>0.02</length></cylinder>
        </geometry>
      </visual>
    </link>

    <joint name="right_steering_hinge_wheel" type="revolute">
      <parent>base_footprint</parent>
      <child>right_steering_hinge</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.52359877</lower>
          <upper>0.52359877</upper>
          <effort>1000.0</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics><damping>0.5</damping><friction>0.1</friction></dynamics>
      </axis>
    </joint>


    <link name="front_right_wheel_link">
      <pose>0.10 -0.07 0.0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01055</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00075</iyy><iyz>0</iyz><izz>0.01055</izz>
        </inertia>
      </inertial>
      <visual name="fr_wheel_visual">
        <pose>0 0 0 3.14159 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/cjinw/simulator-research/limo_sim_ws/install/limo_description/share/limo_description/meshes/limo_wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="fr_wheel_collision">
        <pose>0 -0.0225 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <joint name="front_right_wheel" type="revolute">
      <parent>right_steering_hinge</parent>
      <child>front_right_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>


    <link name="rear_left_wheel_link">
      <pose>-0.10 0.07 0.0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01055</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00075</iyy><iyz>0</iyz><izz>0.01055</izz>
        </inertia>
      </inertial>
      <visual name="rl_wheel_visual">
        <geometry>
          <mesh>
            <uri>file:///home/cjinw/simulator-research/limo_sim_ws/install/limo_description/share/limo_description/meshes/limo_wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="rl_wheel_collision">
        <pose>0 0.0225 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <joint name="rear_left_wheel" type="revolute">
      <parent>base_footprint</parent>
      <child>rear_left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>


    <link name="rear_right_wheel_link">
      <pose>-0.10 -0.07 0.0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01055</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00075</iyy><iyz>0</iyz><izz>0.01055</izz>
        </inertia>
      </inertial>
      <visual name="rr_wheel_visual">
        <pose>0 0 0 3.14159 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/cjinw/simulator-research/limo_sim_ws/install/limo_description/share/limo_description/meshes/limo_wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="rr_wheel_collision">
        <pose>0 -0.0225 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <joint name="rear_right_wheel" type="revolute">
      <parent>base_footprint</parent>
      <child>rear_right_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>


    <plugin filename="libignition-gazebo-ackermann-steering-system.so" name="ignition::gazebo::systems::AckermannSteering">
      <left_joint>rear_left_wheel</left_joint>
      <right_joint>rear_right_wheel</right_joint>
      <left_steering_joint>left_steering_hinge_wheel</left_steering_joint>
      <right_steering_joint>right_steering_hinge_wheel</right_steering_joint>
      <wheel_separation>0.14</wheel_separation>
      <wheel_base>0.20</wheel_base>
      <wheel_radius>0.045</wheel_radius>
      <steering_limit>0.52359877</steering_limit>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>


    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </model>
</sdf>
