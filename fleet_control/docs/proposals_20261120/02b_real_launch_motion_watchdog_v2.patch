+    def validate_motion_watchdog(context):
+        # The watchdog cancels every NavigateToPose goal the Agent does not declare, so direct goal sources
+        # (explore_lite) and the onboard joystick probe (/cmd_vel_raw) are only valid without it, i.e. locked.
+        wd = use_motion_watchdog.perform(context)
+        if wd not in ('true', 'false'):
+            raise RuntimeError('use_motion_watchdog must be true or false')
+        if allow_motor_drive.perform(context) == 'true' and wd != 'true':
+            raise RuntimeError('allow_motor_drive:=true requires use_motion_watchdog:=true')
+        if wd == 'true' and start_explore.perform(context) != 'false':
+            raise RuntimeError('start_explore submits Nav2 goals directly; use web mapping, or use_motion_watchdog:=false (locked only)')
+        if wd == 'true' and manual_probe.perform(context) == 'true':
+            raise RuntimeError('manual_mapping_probe publishes /cmd_vel_raw directly; use use_motion_watchdog:=false (locked only)')
