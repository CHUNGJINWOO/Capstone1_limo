<?xml version="1.0"?>
<!-- Blocking obstacle for the avoidance scenario: a 0.5 x 0.5 x 0.6 m box (taller than the LiDAR plane and the depth camera floor threshold). Spawned at run time only. -->
<sdf version="1.6">
  <model name="obstacle_box">
    <static>true</static>
    <link name="link">
      <collision name="c"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.5 0.5 0.6</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.5 0.5 0.6</size></box></geometry>
        <material><ambient>0.75 0.45 0.15 1</ambient><diffuse>0.85 0.55 0.2 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
