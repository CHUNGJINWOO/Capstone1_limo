<?xml version="1.0"?>
<!-- Moving person for the avoidance/YOLO scenario. @PERSON_MESH@ is replaced at run time with the path of a person mesh (not stored in the repository).
     Velocity is commanded on /model/person_walker/cmd_vel (VelocityControl system). Collision is a simple upright box. -->
<sdf version="1.6">
  <model name="person_walker">
    <link name="link"><gravity>false</gravity>
      <inertial><pose>0 0 0.85 0 0 0</pose><mass>70</mass><inertia><ixx>4000</ixx><iyy>4000</iyy><izz>4000</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><pose>0 0 0.85 0 0 0</pose><geometry><box><size>0.45 0.3 1.7</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.02 0.04 0 0</pose><geometry><mesh><uri>file://@PERSON_MESH@</uri></mesh></geometry></visual>
    </link>
    <plugin filename="libignition-gazebo-velocity-control-system.so" name="ignition::gazebo::systems::VelocityControl"/>
  </model>
</sdf>
