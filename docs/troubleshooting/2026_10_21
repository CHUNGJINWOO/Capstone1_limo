# capstone_ws/src/limo_capstone/config/nav2_explore_params.yaml 수정

기존 AMCL 파라미터는 로봇이 25cm 이상 움직여야만 위치를 갱신하도록 되어 있어 위치 보정이 매우 둔했습니다. 초기 위치 수렴을 빠르게 하도록 민감도를 수정합니다

amcl:
  ros__parameters:
    update_min_d: 0.10        # 기존 0.25 -> 0.10 (10cm만 움직여도 위치 즉시 갱신)
    update_min_a: 0.10        # 기존 0.20 -> 0.10 (약 5.7도 회전 시 위치 즉시 갱신)
    laser_min_range: 0.05     # 기존 -1.0 -> 0.05 (비정상 음수 필터링)
    laser_max_range: 10.0     # 기존 100.0 -> 10.0 (실제 LIMO LiDAR 스펙 8~10m에 맞춤)
    base_frame_id: "base_footprint"

